/// Todas as medidas do modelo, agrupadas por displayFolder.
/// 
/// Ficam numa tabela própria para que a lista de campos mostre dimensões e
/// medidas separadas, em vez de medidas espalhadas por seis fatos.
/// 
/// REGRA DESTE MODELO: medida que envolve grão ou fan-out explica na
/// descrição de qual fato ela sai e por quê. Ticket médio sai sempre de
/// fct_pedido; margem sai sempre de fct_item_pedido.
table _Medidas
	lineageTag: 39984912-0dfd-b13b-cedc-f922c62ec9f4

	/// Contagem de transações. Sai de fct_pedido, nunca do fato de itens.
	measure 'Nº Pedidos' = COUNTROWS(fct_pedido)
		formatString: #,##0
		displayFolder: 1 Vendas
		lineageTag: cbad4bb5-6671-69e3-fa1c-248d481bb916

	/// GMV: soma de orders.total, TODOS os status. É o número da leitura
	/// literal do enunciado — inclui pedidos cancelados e rascunhos.
	measure 'Receita Bruta' = SUM(fct_pedido[total])
		formatString: R$ #,##0
		displayFolder: 1 Vendas
		lineageTag: 60cd3cd0-5699-947d-74b3-44db185bc5da

	/// Só `paid` e `confirmed`. A diferença para a Receita Bruta é de
	/// R$ 207,1 milhões (14,7%) — pedidos que nunca viraram receita.
	measure 'Receita Efetivada' = CALCULATE([Receita Bruta], dim_status_pedido[eh_receita_efetivada] = TRUE())
		formatString: R$ #,##0
		displayFolder: 1 Vendas
		lineageTag: 34d0da20-6ca4-2e9b-d38c-78a22d453f56

	/// Receita dividida por número de PEDIDOS. Como as duas parcelas saem de
	/// fct_pedido, é imune ao fan-out de itens e de pagamentos.
	measure 'Ticket Médio' = DIVIDE([Receita Bruta], [Nº Pedidos])
		formatString: R$ #,##0.00
		displayFolder: 1 Vendas
		lineageTag: 633689d5-5738-07b8-6646-83395b43542f

	/// ALL(dim_status_pedido) no denominador para que a taxa continue correta
	/// mesmo com o slicer de status aplicado.
	measure 'Taxa de Cancelamento' =
			DIVIDE(
			    CALCULATE([Nº Pedidos], dim_status_pedido[status] = "cancelled"),
			    CALCULATE([Nº Pedidos], ALL(dim_status_pedido))
			)
		formatString: 0.0%
		displayFolder: 1 Vendas
		lineageTag: 8eb0b1ba-7a0e-e308-7fd9-e6b55854a6e0

	/// Soma de line_total. Difere da Receita Bruta porque não desconta o
	/// desconto do pedido — é a base sobre a qual a margem é calculada.
	measure 'Receita de Itens' = SUM(fct_item_pedido[valor_linha])
		formatString: R$ #,##0
		displayFolder: 2 Margem
		lineageTag: d5422c28-f40c-51d4-5e27-e31a35fff164

	/// valor_linha − (quantidade × custo), antes do desconto do pedido.
	measure 'Margem Bruta R$' = SUM(fct_item_pedido[margem_bruta])
		formatString: R$ #,##0
		displayFolder: 2 Margem
		lineageTag: 88077ed6-088d-cabb-98cc-0420577255fc

	/// Margem bruta menos o desconto do pedido rateado pela participação da
	/// linha. O rateio reproduz orders.discount_amount ao centavo.
	measure 'Margem Líquida R$' = SUM(fct_item_pedido[margem_liquida])
		formatString: R$ #,##0
		displayFolder: 2 Margem
		lineageTag: b51464ed-3ff2-c756-3610-fe9de7a549e0

	/// Referência do dataset: 42,58%.
	measure '% Margem Bruta' = DIVIDE([Margem Bruta R$], [Receita de Itens])
		formatString: 0.00%
		displayFolder: 2 Margem
		lineageTag: de5f41a2-1030-8e1d-2ae5-263b87cb840a

	/// Referência do dataset: 40,44%.
	measure '% Margem Líquida' = DIVIDE([Margem Líquida R$], [Receita de Itens])
		formatString: 0.00%
		displayFolder: 2 Margem
		lineageTag: bed07cc9-c5c9-d142-d95a-f56c0dd5b6a9

	/// Unidades. É a medida da Questão 4 — Hélices lidera com 492 itens entre
	/// os 10 clientes de elite.
	measure 'Itens Vendidos' = SUM(fct_item_pedido[quantidade])
		formatString: #,##0
		displayFolder: 2 Margem
		lineageTag: 7ed781b2-54c9-5adc-6bca-3cdee6ec0e8c

	/// A MEDIDA DA QUESTÃO 5. O denominador é a contagem de linhas do fato
	/// denso, ou seja, TODOS os dias do calendário — inclusive os 78 em que a
	/// loja abriu e não vendeu nada.
	/// 
	/// Comparar com 'Média por Dia (só dias com venda)' é o argumento inteiro
	/// da questão.
	measure 'Média de Venda por Dia POS' =
			DIVIDE(
			    SUM(fct_venda_diaria_pos[valor_venda]),
			    COUNTROWS(fct_venda_diaria_pos)
			)
		formatString: R$ #,##0
		displayFolder: 3 Sazonalidade
		lineageTag: a789f475-a2ae-c530-2331-96e22240e624

	/// O ERRO DO ESTAGIÁRIO, reproduzido de propósito para a comparação lado a
	/// lado. Divide só pelos dias em que houve venda — que é o que um GROUP BY
	/// direto na tabela de vendas produz.
	/// 
	/// Aponta Segunda-feira como pior dia. A medida correta aponta
	/// Quinta-feira.
	measure 'Média por Dia (só dias com venda)' =
			DIVIDE(
			    SUM(fct_venda_diaria_pos[valor_venda]),
			    CALCULATE(
			        COUNTROWS(fct_venda_diaria_pos),
			        fct_venda_diaria_pos[dia_sem_venda] = FALSE()
			    )
			)
		formatString: R$ #,##0
		displayFolder: 3 Sazonalidade
		lineageTag: 4615d2f8-85e0-2311-f34b-76956999a89a

	/// 78 no período. Concentrados nos anos iniciais: 25 em 2020, 1 em 2025 —
	/// é fenômeno de operação em ramp-up, não característica atual.
	measure 'Dias sem Venda' =
			CALCULATE(
			    COUNTROWS(fct_venda_diaria_pos),
			    fct_venda_diaria_pos[dia_sem_venda] = TRUE()
			)
		formatString: #,##0
		displayFolder: 3 Sazonalidade
		lineageTag: 5eaef8e2-8168-a931-6f3a-436992e0df4c

	/// O tamanho do erro por dia da semana. Não é uniforme: +5,78% na quinta
	/// contra +1,96% na segunda. É essa desigualdade que inverte o ranking.
	measure 'Inflação da Média (erro do estagiário)' =
			DIVIDE(
			    [Média por Dia (só dias com venda)] - [Média de Venda por Dia POS],
			    [Média de Venda por Dia POS]
			)
		formatString: 0.00%
		displayFolder: 3 Sazonalidade
		lineageTag: 515ec3ad-855c-af34-2a3d-2ba8b1110d27

	measure Clientes = DISTINCTCOUNT(fct_pedido[customer_id])
		formatString: #,##0
		displayFolder: 4 Clientes
		lineageTag: 0b383ed9-b9bb-c5b7-e363-c2078e69d33b

	/// Categorias distintas no contexto atual. Só existem 14 na loja — e
	/// 1.971 de 2.000 clientes compraram de 13 ou mais, o que é a razão de o
	/// filtro de elite da Questão 4 não discriminar praticamente ninguém.
	measure 'Diversidade de Categorias' = DISTINCTCOUNT(dim_produto[category_id])
		formatString: #,##0
		displayFolder: 4 Clientes
		lineageTag: b04381e0-6127-b048-efde-efce52dbe6af

	/// Unidades devolvidas sobre unidades vendidas.
	measure 'Taxa de Devolução' = DIVIDE(SUM(fct_devolucao[quantidade]), [Itens Vendidos])
		formatString: 0.00%
		displayFolder: 5 Pós-venda
		lineageTag: 2abc505c-7e84-b85a-7ead-700eea2794a2

	/// Quantidade em mãos avaliada ao custo.
	measure 'Valor em Estoque' = SUM(fct_estoque_atual[valor_em_estoque])
		formatString: R$ #,##0
		displayFolder: 5 Pós-venda
		lineageTag: 4b7a5bd1-6dab-442e-3e2b-925a37a169f3

	/// Vendas mensais efetivas da Bússola de Bordo 702, somando os dois
	/// product_id homônimos (74 e 240).
	measure 'Unidades Realizadas' = SUM(fct_previsao_bussola[realizado])
		formatString: #,##0
		displayFolder: 6 Previsão
		lineageTag: 0e9d279e-7744-ad69-c8a6-05aac859999a

	/// O baseline que o enunciado pede. Constante em 38,67 no horizonte,
	/// somando 116 no trimestre contra 207 realizados.
	measure 'Previsão — Média Móvel 3m' = SUM(fct_previsao_bussola[prev_mm3])
		formatString: #,##0.0
		displayFolder: 6 Previsão
		lineageTag: f27490c4-5179-471f-24b2-995bb702c10f

	/// Repete o mesmo trimestre do ano anterior. MAE de 25,0 contra 30,33 da
	/// média móvel — o baseline pedido perde para a regra mais simples que
	/// existe.
	measure 'Previsão — Seasonal Naive' = SUM(fct_previsao_bussola[prev_sazonal])
		formatString: #,##0.0
		displayFolder: 6 Previsão
		lineageTag: 3543e96e-0097-7805-8899-510b8dbe32e8

	/// Repete o último mês observado (dez/2025 = 22). MAE de 47,0.
	measure 'Previsão — Naive' = SUM(fct_previsao_bussola[prev_naive])
		formatString: #,##0.0
		displayFolder: 6 Previsão
		lineageTag: 740b8e8d-c904-dc02-47ac-0d3d7f029e86

	/// Cosseno contra o 'Motor de Popa 1949'. Há uma linha por produto, então
	/// a soma no grão de produto é o próprio valor.
	measure 'Similaridade de Cosseno' = SUM(fct_similaridade_produto[similaridade])
		formatString: 0.0000
		displayFolder: 7 Recomendação
		lineageTag: 915c1c8b-10ec-bc88-c402-b8887909fa94

	/// Co-ocorrência no MESMO pedido — a formulação correta do problema que a
	/// Marina descreveu, e que devolve outro campeão: Tinta Antifouling 3228.
	measure 'Pedidos em Comum' = SUM(fct_similaridade_produto[pedidos_em_comum])
		formatString: #,##0
		displayFolder: 7 Recomendação
		lineageTag: 60990c74-193c-909e-2224-536c87377f0a

	/// OS CINCO INDICADORES DA CAPA.
	///
	/// FORMA BLOCO — devolve o componente inteiro, então o visual recebe uma
	/// linha só e não emite filtro. Recebe filtro normalmente.
	measure 'HTML — Faixa de KPIs' =
			VAR _Bruta     = [Receita Bruta]
			VAR _Efetivada = [Receita Efetivada]
			VAR _Pct       = DIVIDE(_Efetivada, _Bruta)
			RETURN
			"<div style=""display:flex;flex-direction:row;gap:15px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Receita Bruta</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT(_Bruta / 1000000, "R$ #,##0") & " Mi" & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "GMV — todos os status" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Receita Efetivada</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#2D9CDB;margin-top:10px;white-space:nowrap;"">" & FORMAT(_Efetivada / 1000000, "R$ #,##0") & " Mi" & "</div>"
			& "<div style=""height:3px;background:#16233A;border-radius:2px;margin-top:12px;overflow:hidden;""><div style=""height:3px;border-radius:2px;background:linear-gradient(90deg,#2D9CDB,#8B7AE8);width:" & SUBSTITUTE(FORMAT(_Pct * 100, "0"), ",", ".") & "%""></div></div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & FORMAT(_Pct, "0.0%") & " do GMV virou receita" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Pedidos</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Nº Pedidos], "#,##0") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "2020 a 2026" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Ticket Médio</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Ticket Médio], "R$ #,##0.00") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "a resposta da Questão 1" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Margem Líquida</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#D9772A;margin-top:10px;white-space:nowrap;"">" & FORMAT([% Margem Líquida], "0.00%") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "já líquida de desconto" & "</div>"
			& "</div>"
			& "</div>"
		displayFolder: 0 HTML
		lineageTag: 1378e373-12a9-677e-5ca8-395682d3e749

	/// RECEITA MENSAL, BRUTA E EFETIVADA, em SVG.
	///
	/// A distância entre as duas linhas é o dinheiro que nunca virou receita —
	/// R$ 207,1 milhões no período inteiro.
	///
	/// FORMA BLOCO — devolve o componente inteiro, então o visual recebe uma
	/// linha só e não emite filtro. Recebe filtro normalmente.
	measure 'HTML — Série de Receita' =
			VAR _Base = ALLSELECTED(dim_data[ano_mes])
			VAR _T =
			    ADDCOLUMNS(
			        _Base,
			        "@i", VALUE(LEFT(dim_data[ano_mes], 4)) * 12 + VALUE(MID(dim_data[ano_mes], 6, 2)),
			        "@v1", [Receita Bruta],
			        "@v2", [Receita Efetivada]
			    )
			VAR _Ini = MINX(_T, [@i])
			VAR _N   = MAXX(_T, [@i]) - _Ini
			VAR _RotIni = MINX(_T, dim_data[ano_mes]) & ""
			VAR _RotFim = MAXX(_T, dim_data[ano_mes]) & ""
			VAR _Centro = _Ini + DIVIDE(_N, 2)
			VAR _RotMeio = MINX(TOPN(1, _T, ABS([@i] - _Centro), ASC), dim_data[ano_mes]) & ""
			VAR _Max = MAX(MAXX(_T, [@v1]), MAXX(_T, [@v2]))
			VAR _Min = 0
			VAR _Fim1 = MAXX(TOPN(1, FILTER(_T, NOT ISBLANK([@v1])), [@i], DESC), [@v1])
			VAR _Fim2 = MAXX(TOPN(1, FILTER(_T, NOT ISBLANK([@v2])), [@i], DESC), [@v2])
			VAR _P1 =
			    CONCATENATEX(
			        FILTER(_T, NOT ISBLANK([@v1])),
			        SUBSTITUTE(FORMAT([@i] - _Ini, "0"), ",", ".") & "," & SUBSTITUTE(FORMAT(140 - DIVIDE([@v1] - _Min, _Max - _Min) * 134, "0.00"), ",", "."),
			        " ", [@i], ASC
			    )
			VAR _P2 =
			    CONCATENATEX(
			        FILTER(_T, NOT ISBLANK([@v2])),
			        SUBSTITUTE(FORMAT([@i] - _Ini, "0"), ",", ".") & "," & SUBSTITUTE(FORMAT(140 - DIVIDE([@v2] - _Min, _Max - _Min) * 134, "0.00"), ",", "."),
			        " ", [@i], ASC
			    )
			RETURN
			    "<div style=""font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			  & "<div style=""display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:#93A5B8;margin-bottom:5px;align-items:center;"">"
			  & "<span><span style=""width:8px;height:8px;border-radius:4px;background:#2D9CDB;display:inline-block;margin-right:5px;""></span>Bruta " & "<b style=""color:#E8EEF4;font-weight:600;"">" & FORMAT(_Fim1, "R$ #,##0,, "" Mi""") & "</b></span>"
			  & "<span><span style=""width:8px;height:8px;border-radius:4px;background:#D9772A;display:inline-block;margin-right:5px;""></span>Efetivada " & "<b style=""color:#E8EEF4;font-weight:600;"">" & FORMAT(_Fim2, "R$ #,##0,, "" Mi""") & "</b></span>"
			  & "</div>"
			  & "<svg viewBox=""0 0 " & _N & " 140"" preserveAspectRatio=""none"" style=""width:100%;height:140px;display:block;"">"
			  & "<defs><lineargradient id=""lhg"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0%"" stop-color=""#2D9CDB"" stop-opacity="".45""></stop><stop offset=""100%"" stop-color=""#2D9CDB"" stop-opacity=""0""></stop></lineargradient></defs>"
			  & "<polygon fill=""url(#lhg)"" points=""0,140 " & _P1 & " " & _N & ",140""></polygon>"
			  & "<polyline fill=""none"" stroke=""#2D9CDB"" stroke-width=""1.6"" vector-effect=""non-scaling-stroke"" stroke-linejoin=""round"" stroke-linecap=""round"" points=""" & _P1 & """></polyline>"
			  & "<polyline fill=""none"" stroke=""#D9772A"" stroke-width=""1.6"" vector-effect=""non-scaling-stroke"" stroke-linejoin=""round"" stroke-linecap=""round"" points=""" & _P2 & """></polyline>"
			  & "</svg>"
			  & "<div style=""display:flex;justify-content:space-between;font-size:10px;color:#6F8299;margin-top:4px;""><span>" & _RotIni & "</span><span>" & _RotMeio & "</span><span>" & _RotFim & "</span></div></div>"
		displayFolder: 0 HTML
		lineageTag: 00852169-6575-0cbc-b5a7-624ab13095ef

	/// RECEITA POR STATUS DO PEDIDO.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Status' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_status_pedido[status_exibicao]), "@m", [Receita Bruta] / 1000000),
			        ALLSELECTED(dim_status_pedido)
			    )
			VAR _V   = [Receita Bruta] / 1000000
			VAR _Max = MAXX(TOPN(4, _Tab, [@m], DESC), [@m])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 4
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:104px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_status_pedido[status_exibicao]) & "</div>"
			      & "<div style=""flex:1;height:8px;background:#16233A;border-radius:4px;overflow:hidden;min-width:26px;""><div style=""height:8px;border-radius:4px;background:linear-gradient(90deg,#2D9CDB,#2D9CDB66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""width:78px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "R$ #,##0"" Mi""") & "</div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: 7a335205-a896-783c-1519-5020dd69f4b1

	/// PEDIDOS POR CANAL.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Canal' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_canal[canal_exibicao]), "@m", [Nº Pedidos]),
			        ALLSELECTED(dim_canal)
			    )
			VAR _V   = [Nº Pedidos]
			VAR _Max = MAXX(TOPN(2, _Tab, [@m], DESC), [@m])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 2
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:92px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_canal[canal_exibicao]) & "</div>"
			      & "<div style=""flex:1;height:8px;background:#16233A;border-radius:4px;overflow:hidden;min-width:26px;""><div style=""height:8px;border-radius:4px;background:linear-gradient(90deg,#8B7AE8,#8B7AE866);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""width:78px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "#,##0") & "</div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: d2a2796e-4385-56bf-c7ef-5ef6fca0abc9

	/// AS CINCO MAIORES CATEGORIAS POR MARGEM LÍQUIDA.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Categoria' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_produto[categoria]), "@m", [Margem Líquida R$] / 1000000),
			        ALLSELECTED(dim_produto)
			    )
			VAR _V   = [Margem Líquida R$] / 1000000
			VAR _Max = MAXX(TOPN(5, _Tab, [@m], DESC), [@m])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 5
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:120px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_produto[categoria]) & "</div>"
			      & "<div style=""flex:1;height:8px;background:#16233A;border-radius:4px;overflow:hidden;min-width:26px;""><div style=""height:8px;border-radius:4px;background:linear-gradient(90deg,#D9772A,#D9772A66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""width:78px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "R$ #,##0"" Mi""") & "</div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: 56ad3982-3298-9a25-39fd-7cecede4adab

	/// INDICADORES DE MARGEM.
	///
	/// O terceiro cartão troca o `% Margem Bruta` do desenho antigo pelo
	/// DESCONTO em reais — a diferença entre as duas margens, que é o número
	/// que ninguém olha e explica o resto da página.
	///
	/// FORMA BLOCO — devolve o componente inteiro, então o visual recebe uma
	/// linha só e não emite filtro. Recebe filtro normalmente.
	measure 'HTML — Faixa de Margem' =
			"<div style=""display:flex;flex-direction:row;gap:15px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Receita de Itens</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Receita de Itens] / 1000000, "R$ #,##0") & " Mi" & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "grão de item — 147.320 linhas" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Margem Bruta</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Margem Bruta R$] / 1000000, "R$ #,##0") & " Mi" & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & FORMAT([% Margem Bruta], "0.00%") & " da receita" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Desconto</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#D9772A;margin-top:10px;white-space:nowrap;"">" & FORMAT(([Margem Bruta R$] - [Margem Líquida R$]) / 1000000, "R$ #,##0") & " Mi" & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "rateado por linha de item" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Margem Líquida</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Margem Líquida R$] / 1000000, "R$ #,##0") & " Mi" & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "depois do desconto" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">% Margem Líquida</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#2D9CDB;margin-top:10px;white-space:nowrap;"">" & FORMAT([% Margem Líquida], "0.00%") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "estável em todo o período" & "</div>"
			& "</div>"
			& "</div>"
		displayFolder: 0 HTML
		lineageTag: 0817ed3d-d400-a80f-3535-1cdfee8d036b

	/// RECEITA E MARGEM POR CATEGORIA, as duas barras empilhadas.
	///
	/// Empilhadas e não lado a lado porque a comparação é entre as DUAS de uma
	/// mesma categoria, não entre categorias — e é a proporção constante entre
	/// elas que sustenta o título da página.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Categoria Dupla' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_produto[categoria]), "@m", [Receita de Itens] / 1000000, "@m2", [Margem Líquida R$] / 1000000),
			        ALLSELECTED(dim_produto)
			    )
			VAR _V   = [Receita de Itens] / 1000000
			VAR _V2  = [Margem Líquida R$] / 1000000
			VAR _Max = MAXX(TOPN(7, _Tab, [@m], DESC), [@m])
			VAR _Max2 = MAXX(TOPN(7, _Tab, [@m2], DESC), [@m2])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 7
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:116px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_produto[categoria]) & "</div>"
			      & "<div style=""flex:1;min-width:40px;"">"
			      & "<div style=""flex:1;height:7px;background:#16233A;border-radius:3px;overflow:hidden;min-width:26px;""><div style=""height:7px;border-radius:3px;background:linear-gradient(90deg,#2D9CDB,#2D9CDB66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""flex:1;height:7px;background:#16233A;border-radius:3px;overflow:hidden;min-width:26px;margin-top:3px;""><div style=""height:7px;border-radius:3px;background:linear-gradient(90deg,#D9772A,#D9772A66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V2, _Max2) * 100, "0.0"), ",", ".")
			      & "%""></div></div></div>"
			      & "<div style=""width:68px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "R$ #,##0"" Mi""")
			      & "<br><span style=""color:#D9772A;"">" & FORMAT(_V2, "R$ #,##0"" Mi""") & "</span></div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: 4b414eea-e226-da9f-d951-e9b178283d78

	/// TOP 10 PRODUTOS POR MARGEM.
	///
	/// A barra é proporcional ao MAIOR DA LISTA, não a 100%: as margens vão de
	/// 37% a 53%, e num eixo de 0 a 100 nada se distinguiria. O valor absoluto
	/// vai no rótulo, então a escala relativa não engana.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Produto' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_produto[produto]), "@m", [% Margem Líquida]),
			        ALLSELECTED(dim_produto)
			    )
			VAR _V   = [% Margem Líquida]
			VAR _Max = MAXX(TOPN(9, _Tab, [@m], DESC), [@m])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 9
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:168px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_produto[produto]) & "</div>"
			      & "<div style=""flex:1;height:8px;background:#16233A;border-radius:4px;overflow:hidden;min-width:26px;""><div style=""height:8px;border-radius:4px;background:linear-gradient(90deg,#D9772A,#D9772A66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""width:78px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "0.00%") & "</div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: 05c25cd0-2bc7-e264-48e8-8eceb4decc6d

	/// MARGEM PERCENTUAL MÊS A MÊS, em SVG.
	///
	/// FORMA BLOCO — devolve o componente inteiro, então o visual recebe uma
	/// linha só e não emite filtro. Recebe filtro normalmente.
	measure 'HTML — Série de Margem' =
			VAR _Base = ALLSELECTED(dim_data[ano_mes])
			VAR _T =
			    ADDCOLUMNS(
			        _Base,
			        "@i", VALUE(LEFT(dim_data[ano_mes], 4)) * 12 + VALUE(MID(dim_data[ano_mes], 6, 2)),
			        "@v1", [% Margem Líquida]
			    )
			VAR _Ini = MINX(_T, [@i])
			VAR _N   = MAXX(_T, [@i]) - _Ini
			VAR _RotIni = MINX(_T, dim_data[ano_mes]) & ""
			VAR _RotFim = MAXX(_T, dim_data[ano_mes]) & ""
			VAR _Centro = _Ini + DIVIDE(_N, 2)
			VAR _RotMeio = MINX(TOPN(1, _T, ABS([@i] - _Centro), ASC), dim_data[ano_mes]) & ""
			VAR _Teto = MAXX(_T, [@v1])
			VAR _Piso = MINX(_T, [@v1])
			VAR _Folga = (_Teto - _Piso) * 0.12
			VAR _Max = _Teto + _Folga
			VAR _Min = _Piso - _Folga
			VAR _Fim1 = MAXX(TOPN(1, FILTER(_T, NOT ISBLANK([@v1])), [@i], DESC), [@v1])
			VAR _P1 =
			    CONCATENATEX(
			        FILTER(_T, NOT ISBLANK([@v1])),
			        SUBSTITUTE(FORMAT([@i] - _Ini, "0"), ",", ".") & "," & SUBSTITUTE(FORMAT(30 - DIVIDE([@v1] - _Min, _Max - _Min) * 24, "0.00"), ",", "."),
			        " ", [@i], ASC
			    )
			RETURN
			    "<div style=""font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			  & "<div style=""display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:#93A5B8;margin-bottom:5px;align-items:center;"">"
			  & "<span><span style=""width:8px;height:8px;border-radius:4px;background:#2D9CDB;display:inline-block;margin-right:5px;""></span>Margem " & "<b style=""color:#E8EEF4;font-weight:600;"">" & FORMAT(_Fim1, "0.00%") & "</b></span>"
			  & "</div>"
			  & "<svg viewBox=""0 0 " & _N & " 30"" preserveAspectRatio=""none"" style=""width:100%;height:30px;display:block;"">"
			  & "<defs><lineargradient id=""lhg"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0%"" stop-color=""#2D9CDB"" stop-opacity="".45""></stop><stop offset=""100%"" stop-color=""#2D9CDB"" stop-opacity=""0""></stop></lineargradient></defs>"
			  & "<polyline fill=""none"" stroke=""#2D9CDB"" stroke-width=""1.6"" vector-effect=""non-scaling-stroke"" stroke-linejoin=""round"" stroke-linecap=""round"" points=""" & _P1 & """></polyline>"
			  & "</svg>"
			  & "<div style=""display:flex;justify-content:space-between;font-size:10px;color:#6F8299;margin-top:4px;""><span>" & _RotIni & "</span><span>" & _RotMeio & "</span><span>" & _RotFim & "</span></div></div>"
		displayFolder: 0 HTML
		lineageTag: 3a8a01ad-3c02-b88d-79de-92bdcef23fd1

	/// INDICADORES DE CLIENTE.
	///
	/// FORMA BLOCO — devolve o componente inteiro, então o visual recebe uma
	/// linha só e não emite filtro. Recebe filtro normalmente.
	measure 'HTML — Faixa de Clientes' =
			"<div style=""display:flex;flex-direction:row;gap:15px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Clientes</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Clientes], "#,##0") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "todos compraram" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Ticket Médio</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#2D9CDB;margin-top:10px;white-space:nowrap;"">" & FORMAT([Ticket Médio], "R$ #,##0.00") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "o critério do ranking" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Pedidos</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Nº Pedidos], "#,##0") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "2020 a 2026" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Itens Vendidos</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Itens Vendidos], "#,##0") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "soma das quantidades" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Taxa de Devolução</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#D9772A;margin-top:10px;white-space:nowrap;"">" & FORMAT([Taxa de Devolução], "0.00%") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "sobre itens vendidos" & "</div>"
			& "</div>"
			& "</div>"
		displayFolder: 0 HTML
		lineageTag: 2445292e-49bd-eea5-37c5-19d490958350

	/// TOP 10 CLIENTES POR TICKET MÉDIO — o ranking literal da Questão 4.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Cliente' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_cliente[cliente]), "@m", [Ticket Médio]),
			        ALLSELECTED(dim_cliente)
			    )
			VAR _V   = [Ticket Médio]
			VAR _Max = MAXX(TOPN(8, _Tab, [@m], DESC), [@m])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 8
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:168px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_cliente[cliente]) & "</div>"
			      & "<div style=""flex:1;height:8px;background:#16233A;border-radius:4px;overflow:hidden;min-width:26px;""><div style=""height:8px;border-radius:4px;background:linear-gradient(90deg,#8B7AE8,#8B7AE866);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""width:78px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "R$ #,##0") & "</div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: f9ec154e-f3b6-8a6e-acb8-65a8c58562d2

	/// TICKET × FATURAMENTO, no mesmo cliente.
	///
	/// As duas barras raramente acompanham uma à outra, e é esse descompasso
	/// que mostra que ticket alto não é o mesmo que cliente valioso.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Cliente Dupla' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_cliente[cliente]), "@m", [Ticket Médio], "@m2", [Receita Bruta] / 1000000),
			        ALLSELECTED(dim_cliente)
			    )
			VAR _V   = [Ticket Médio]
			VAR _V2  = [Receita Bruta] / 1000000
			VAR _Max = MAXX(TOPN(4, _Tab, [@m], DESC), [@m])
			VAR _Max2 = MAXX(TOPN(4, _Tab, [@m2], DESC), [@m2])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 4
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:96px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_cliente[cliente]) & "</div>"
			      & "<div style=""flex:1;min-width:40px;"">"
			      & "<div style=""flex:1;height:7px;background:#16233A;border-radius:3px;overflow:hidden;min-width:26px;""><div style=""height:7px;border-radius:3px;background:linear-gradient(90deg,#2D9CDB,#2D9CDB66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""flex:1;height:7px;background:#16233A;border-radius:3px;overflow:hidden;min-width:26px;margin-top:3px;""><div style=""height:7px;border-radius:3px;background:linear-gradient(90deg,#D9772A,#D9772A66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V2, _Max2) * 100, "0.0"), ",", ".")
			      & "%""></div></div></div>"
			      & "<div style=""width:62px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "R$ #,##0")
			      & "<br><span style=""color:#D9772A;"">" & FORMAT(_V2, "R$ #,##0.0"" Mi""") & "</span></div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: be766c21-0b14-fe70-cafd-7fdabd01d8ee

	/// CATEGORIAS POR ITENS VENDIDOS.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Categoria Itens' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_produto[categoria]), "@m", [Itens Vendidos]),
			        ALLSELECTED(dim_produto)
			    )
			VAR _V   = [Itens Vendidos]
			VAR _Max = MAXX(TOPN(8, _Tab, [@m], DESC), [@m])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 8
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:88px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_produto[categoria]) & "</div>"
			      & "<div style=""flex:1;height:8px;background:#16233A;border-radius:4px;overflow:hidden;min-width:26px;""><div style=""height:8px;border-radius:4px;background:linear-gradient(90deg,#2D9CDB,#2D9CDB66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""width:62px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "#,##0") & "</div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: d2363932-5610-be59-c717-9c88f833870e

	/// OS QUATRO NÚMEROS DA QUESTÃO 5.
	///
	/// FORMA BLOCO — devolve o componente inteiro, então o visual recebe uma
	/// linha só e não emite filtro. Recebe filtro normalmente.
	measure 'HTML — Faixa de Sazonalidade' =
			"<div style=""display:flex;flex-direction:row;gap:15px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Média Correta</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#2D9CDB;margin-top:10px;white-space:nowrap;"">" & FORMAT([Média de Venda por Dia POS], "R$ #,##0") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "divide pelo calendário inteiro" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Média Ingênua</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#D9772A;margin-top:10px;white-space:nowrap;"">" & FORMAT([Média por Dia (só dias com venda)], "R$ #,##0") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "só dias com venda — o erro" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Dias sem Venda</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Dias sem Venda], "#,##0") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "de 2.557 dias de calendário" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Inflação da Média</div>"
			& "<div style=""font-size:30px;line-height:1.1;font-weight:200;color:#D9772A;margin-top:10px;white-space:nowrap;"">" & FORMAT([Inflação da Média (erro do estagiário)], "0.00%") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "e não é uniforme entre os dias" & "</div>"
			& "</div>"
			& "</div>"
		displayFolder: 0 HTML
		lineageTag: f78be799-fd48-35f2-a614-804eae3d927f

	/// AS DUAS MÉDIAS, DIA A DIA — o visual mais importante do painel.
	///
	/// Ordem natural da semana, não por valor: o leitor procura o dia, não a
	/// posição. A barra de cima é a média correta e a de baixo a ingênua; onde
	/// a laranja se estica mais, o erro é maior — e ele é maior justamente na
	/// quinta-feira, que é o que inverte o ranking.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Dia' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_data[dia_semana]), "@m", [Média de Venda por Dia POS], "@m2", [Média por Dia (só dias com venda)]),
			        ALLSELECTED(dim_data)
			    )
			VAR _V   = [Média de Venda por Dia POS]
			VAR _V2  = [Média por Dia (só dias com venda)]
			VAR _Max = MAXX(TOPN(7, _Tab, [@m], DESC), [@m])
			VAR _Max2 = MAXX(TOPN(7, _Tab, [@m2], DESC), [@m2])
			VAR _Dentro = NOT ISBLANK(_V)
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:116px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_data[dia_semana]) & "</div>"
			      & "<div style=""flex:1;min-width:40px;"">"
			      & "<div style=""flex:1;height:7px;background:#16233A;border-radius:3px;overflow:hidden;min-width:26px;""><div style=""height:7px;border-radius:3px;background:linear-gradient(90deg,#2D9CDB,#2D9CDB66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""flex:1;height:7px;background:#16233A;border-radius:3px;overflow:hidden;min-width:26px;margin-top:3px;""><div style=""height:7px;border-radius:3px;background:linear-gradient(90deg,#D9772A,#D9772A66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V2, _Max2) * 100, "0.0"), ",", ".")
			      & "%""></div></div></div>"
			      & "<div style=""width:72px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "R$ #,##0")
			      & "<br><span style=""color:#D9772A;"">" & FORMAT(_V2, "R$ #,##0") & "</span></div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: 145cebab-8832-5f93-dba9-43a8885e97b5

	/// DIAS SEM VENDA POR DIA DA SEMANA.
	///
	/// 20 na quinta contra 7 na segunda — a desigualdade que faz a média
	/// ingênua inflar mais um dia que outro e trocar o pior dia da semana.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Dia Vazio' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_data[dia_semana]), "@m", [Dias sem Venda]),
			        ALLSELECTED(dim_data)
			    )
			VAR _V   = [Dias sem Venda]
			VAR _Max = MAXX(TOPN(7, _Tab, [@m], DESC), [@m])
			VAR _Dentro = NOT ISBLANK(_V)
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:116px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(dim_data[dia_semana]) & "</div>"
			      & "<div style=""flex:1;height:8px;background:#16233A;border-radius:4px;overflow:hidden;min-width:26px;""><div style=""height:8px;border-radius:4px;background:linear-gradient(90deg,#D9772A,#D9772A66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""width:44px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "#,##0") & "</div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: 6e82700b-dd5e-7590-4a56-c25a18587fa4

	/// DIAS SEM VENDA POR ANO, em SVG.
	///
	/// Era uma lista, e virou série porque a lista só cabia com quatro anos —
	/// e a queda de 25 em 2020 para 1 em 2025 é justamente o que a página
	/// quer mostrar. A curva mostra os sete de uma vez.
	///
	/// FORMA BLOCO — devolve o componente inteiro, então o visual recebe uma
	/// linha só e não emite filtro. Recebe filtro normalmente.
	measure 'HTML — Série de Dias Vazios' =
			VAR _Base = ALLSELECTED(dim_data[ano])
			VAR _T =
			    ADDCOLUMNS(
			        _Base,
			        "@i", dim_data[ano],
			        "@v1", [Dias sem Venda]
			    )
			VAR _Ini = MINX(_T, [@i])
			VAR _N   = MAXX(_T, [@i]) - _Ini
			VAR _RotIni = MINX(_T, dim_data[ano]) & ""
			VAR _RotFim = MAXX(_T, dim_data[ano]) & ""
			VAR _Centro = _Ini + DIVIDE(_N, 2)
			VAR _RotMeio = MINX(TOPN(1, _T, ABS([@i] - _Centro), ASC), dim_data[ano]) & ""
			VAR _Max = MAXX(_T, [@v1])
			VAR _Min = 0
			VAR _Fim1 = MAXX(TOPN(1, FILTER(_T, NOT ISBLANK([@v1])), [@i], DESC), [@v1])
			VAR _P1 =
			    CONCATENATEX(
			        FILTER(_T, NOT ISBLANK([@v1])),
			        SUBSTITUTE(FORMAT([@i] - _Ini, "0"), ",", ".") & "," & SUBSTITUTE(FORMAT(100 - DIVIDE([@v1] - _Min, _Max - _Min) * 94, "0.00"), ",", "."),
			        " ", [@i], ASC
			    )
			RETURN
			    "<div style=""font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			  & "<div style=""display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:#93A5B8;margin-bottom:5px;align-items:center;"">"
			  & "<span><span style=""width:8px;height:8px;border-radius:4px;background:#8B7AE8;display:inline-block;margin-right:5px;""></span>Dias sem venda " & "<b style=""color:#E8EEF4;font-weight:600;"">" & FORMAT(_Fim1, "#,##0 "" no último ano""") & "</b></span>"
			  & "</div>"
			  & "<svg viewBox=""0 0 " & _N & " 100"" preserveAspectRatio=""none"" style=""width:100%;height:100px;display:block;"">"
			  & "<defs><lineargradient id=""lhg"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0%"" stop-color=""#8B7AE8"" stop-opacity="".45""></stop><stop offset=""100%"" stop-color=""#8B7AE8"" stop-opacity=""0""></stop></lineargradient></defs>"
			  & "<polygon fill=""url(#lhg)"" points=""0,100 " & _P1 & " " & _N & ",100""></polygon>"
			  & "<polyline fill=""none"" stroke=""#8B7AE8"" stroke-width=""1.6"" vector-effect=""non-scaling-stroke"" stroke-linejoin=""round"" stroke-linecap=""round"" points=""" & _P1 & """></polyline>"
			  & "</svg>"
			  & "<div style=""display:flex;justify-content:space-between;font-size:10px;color:#6F8299;margin-top:4px;""><span>" & _RotIni & "</span><span>" & _RotMeio & "</span><span>" & _RotFim & "</span></div></div>"
		displayFolder: 0 HTML
		lineageTag: 612c4980-0a05-f75e-ba0f-d7cb7bc51abf

	/// A SÉRIE DA BÚSSOLA DE BORDO 702, em SVG.
	///
	/// A linha laranja só existe nos três meses de teste — é ali que a previsão
	/// descola do realizado. Os 75 meses cabem sem rolagem, que era o defeito
	/// do gráfico nativo aqui: a previsão ficava fora da janela visível.
	///
	/// FORMA BLOCO — devolve o componente inteiro, então o visual recebe uma
	/// linha só e não emite filtro. Recebe filtro normalmente.
	measure 'HTML — Série da Bússola' =
			VAR _Base = ALLSELECTED(fct_previsao_bussola[ano_mes])
			VAR _T =
			    ADDCOLUMNS(
			        _Base,
			        "@i", VALUE(LEFT(fct_previsao_bussola[ano_mes], 4)) * 12 + VALUE(MID(fct_previsao_bussola[ano_mes], 6, 2)),
			        "@v1", [Unidades Realizadas],
			        "@v2", [Previsão — Média Móvel 3m]
			    )
			VAR _Ini = MINX(_T, [@i])
			VAR _N   = MAXX(_T, [@i]) - _Ini
			VAR _RotIni = MINX(_T, fct_previsao_bussola[ano_mes]) & ""
			VAR _RotFim = MAXX(_T, fct_previsao_bussola[ano_mes]) & ""
			VAR _Centro = _Ini + DIVIDE(_N, 2)
			VAR _RotMeio = MINX(TOPN(1, _T, ABS([@i] - _Centro), ASC), fct_previsao_bussola[ano_mes]) & ""
			VAR _Max = MAX(MAXX(_T, [@v1]), MAXX(_T, [@v2]))
			VAR _Min = 0
			VAR _Fim1 = MAXX(TOPN(1, FILTER(_T, NOT ISBLANK([@v1])), [@i], DESC), [@v1])
			VAR _Fim2 = MAXX(TOPN(1, FILTER(_T, NOT ISBLANK([@v2])), [@i], DESC), [@v2])
			VAR _P1 =
			    CONCATENATEX(
			        FILTER(_T, NOT ISBLANK([@v1])),
			        SUBSTITUTE(FORMAT([@i] - _Ini, "0"), ",", ".") & "," & SUBSTITUTE(FORMAT(100 - DIVIDE([@v1] - _Min, _Max - _Min) * 94, "0.00"), ",", "."),
			        " ", [@i], ASC
			    )
			VAR _P2 =
			    CONCATENATEX(
			        FILTER(_T, NOT ISBLANK([@v2])),
			        SUBSTITUTE(FORMAT([@i] - _Ini, "0"), ",", ".") & "," & SUBSTITUTE(FORMAT(100 - DIVIDE([@v2] - _Min, _Max - _Min) * 94, "0.00"), ",", "."),
			        " ", [@i], ASC
			    )
			RETURN
			    "<div style=""font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			  & "<div style=""display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:#93A5B8;margin-bottom:5px;align-items:center;"">"
			  & "<span><span style=""width:8px;height:8px;border-radius:4px;background:#2D9CDB;display:inline-block;margin-right:5px;""></span>Realizado " & "<b style=""color:#E8EEF4;font-weight:600;"">" & FORMAT(_Fim1, "#,##0 "" un""") & "</b></span>"
			  & "<span><span style=""width:8px;height:8px;border-radius:4px;background:#D9772A;display:inline-block;margin-right:5px;""></span>Previsto " & "<b style=""color:#E8EEF4;font-weight:600;"">" & FORMAT(_Fim2, "#,##0 "" un""") & "</b></span>"
			  & "</div>"
			  & "<svg viewBox=""0 0 " & _N & " 100"" preserveAspectRatio=""none"" style=""width:100%;height:100px;display:block;"">"
			  & "<defs><lineargradient id=""lhg"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0%"" stop-color=""#2D9CDB"" stop-opacity="".45""></stop><stop offset=""100%"" stop-color=""#2D9CDB"" stop-opacity=""0""></stop></lineargradient></defs>"
			  & "<polygon fill=""url(#lhg)"" points=""0,100 " & _P1 & " " & _N & ",100""></polygon>"
			  & "<polyline fill=""none"" stroke=""#2D9CDB"" stroke-width=""1.6"" vector-effect=""non-scaling-stroke"" stroke-linejoin=""round"" stroke-linecap=""round"" points=""" & _P1 & """></polyline>"
			  & "<polyline fill=""none"" stroke=""#D9772A"" stroke-width=""1.6"" vector-effect=""non-scaling-stroke"" stroke-linejoin=""round"" stroke-linecap=""round"" points=""" & _P2 & """></polyline>"
			  & "</svg>"
			  & "<div style=""display:flex;justify-content:space-between;font-size:10px;color:#6F8299;margin-top:4px;""><span>" & _RotIni & "</span><span>" & _RotMeio & "</span><span>" & _RotFim & "</span></div></div>"
		displayFolder: 0 HTML
		lineageTag: 85a1c971-a6f0-71a4-2ed5-472a533d44ec

	/// O CONFRONTO DA QUESTÃO 6: 207 realizadas contra 116 previstas.
	///
	/// FORMA BLOCO — devolve o componente inteiro, então o visual recebe uma
	/// linha só e não emite filtro. Recebe filtro normalmente.
	measure 'HTML — Faixa da Previsão' =
			"<div style=""display:flex;flex-direction:row;gap:15px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Realizado</div>"
			& "<div style=""font-size:26px;line-height:1.1;font-weight:200;color:#2D9CDB;margin-top:10px;white-space:nowrap;"">" & FORMAT([Realizado no Trimestre], "#,##0") & " un" & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "jan a mar de 2026" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Previsto (MM3)</div>"
			& "<div style=""font-size:26px;line-height:1.1;font-weight:200;color:#E8EEF4;margin-top:10px;white-space:nowrap;"">" & FORMAT([Previsão — Média Móvel 3m], "#,##0") & " un" & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "o baseline do enunciado" & "</div>"
			& "</div>"
			& "<div style=""flex:1;min-width:0;background:#12203366;border:1px solid #1E2E42;border-radius:14px;padding:14px 16px;"">"
			& "<div style=""font-size:10px;letter-spacing:.10em;text-transform:uppercase;color:#93A5B8;font-weight:600;white-space:nowrap;"">Erro do Baseline</div>"
			& "<div style=""font-size:26px;line-height:1.1;font-weight:200;color:#D9772A;margin-top:10px;white-space:nowrap;"">" & FORMAT([Erro da Previsão], "0.0%") & "</div>"
			& "<div style=""font-size:11px;color:#6F8299;margin-top:8px;white-space:nowrap;"">" & "previu " & FORMAT([Realizado no Trimestre] - [Previsão — Média Móvel 3m], "#,##0") & " unidades a menos" & "</div>"
			& "</div>"
			& "</div>"
		displayFolder: 0 HTML
		lineageTag: 59364cd2-e3e5-56f3-e870-5da5074a4702

	/// RANKING DA QUESTÃO 7.
	///
	/// Quatro casas decimais de propósito: o 1º ganha do 2º por 0,0003, e
	/// arredondar para duas empataria os três primeiros — que é exatamente o
	/// argumento da resposta.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Similar' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(fct_similaridade_produto[produto]), "@m", [Similaridade de Cosseno]),
			        ALLSELECTED(fct_similaridade_produto)
			    )
			VAR _V   = [Similaridade de Cosseno]
			VAR _Max = MAXX(TOPN(7, _Tab, [@m], DESC), [@m])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 7
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:150px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(fct_similaridade_produto[produto]) & "</div>"
			      & "<div style=""flex:1;height:8px;background:#16233A;border-radius:4px;overflow:hidden;min-width:26px;""><div style=""height:8px;border-radius:4px;background:linear-gradient(90deg,#2D9CDB,#2D9CDB66);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""width:78px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "0.0000") & "</div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: 2706a5bf-e428-0bd1-32c4-0d60f369763b

	/// CO-OCORRÊNCIA NO MESMO PEDIDO — a formulação correta do problema da
	/// Marina, que devolve outro campeão: Tinta Antifouling.
	///
	/// FORMA LINHA — devolve UMA linha, e a coluna de granularidade entra no
	/// papel `sampling` do visual. É isso que dá cross-filter: o visual cria um
	/// selectionId por linha, e clicar filtra a página como um gráfico nativo.
	measure 'HTML — Linha de Cesta' =
			VAR _Tab =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(fct_similaridade_produto[produto]), "@m", [Pedidos em Comum]),
			        ALLSELECTED(fct_similaridade_produto)
			    )
			VAR _V   = [Pedidos em Comum]
			VAR _Max = MAXX(TOPN(7, _Tab, [@m], DESC), [@m])
			VAR _Pos = COUNTROWS(FILTER(_Tab, [@m] > _V)) + 1
			VAR _Dentro = _Pos <= 7
			RETURN
			    IF(
			        _Dentro,
			        "<div style=""display:flex;align-items:center;gap:9px;padding:2px 2px;font-family:Segoe UI,-apple-system,Roboto,sans-serif;"">"
			      & "<div style=""width:18px;font-size:11px;color:#6F8299;text-align:right;flex:none;"">" & _Pos & "</div>"
			      & "<div style=""width:150px;font-size:12px;color:#E8EEF4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:none;"">"
			      & SELECTEDVALUE(fct_similaridade_produto[produto]) & "</div>"
			      & "<div style=""flex:1;height:8px;background:#16233A;border-radius:4px;overflow:hidden;min-width:26px;""><div style=""height:8px;border-radius:4px;background:linear-gradient(90deg,#8B7AE8,#8B7AE866);width:"
			      & SUBSTITUTE(FORMAT(DIVIDE(_V, _Max) * 100, "0.0"), ",", ".")
			      & "%""></div></div>"
			      & "<div style=""width:52px;text-align:right;font-size:12px;color:#93A5B8;flex:none;line-height:1.35;"">" & FORMAT(_V, "#,##0") & "</div>"
			      & "</div>"
			    )
		displayFolder: 0 HTML
		lineageTag: 7b3a4b1b-6c82-080e-ff36-52adf4893d43

	/// As 207 unidades efetivamente vendidas no trimestre de teste
	/// (jan–mar/2026). Recorta pela flag `eh_treino`, e não por datas
	/// escritas à mão, para que a medida acompanhe a janela do modelo se
	/// ela mudar.
	measure 'Realizado no Trimestre' =
			CALCULATE(
			    SUM(fct_previsao_bussola[realizado]),
			    fct_previsao_bussola[eh_treino] = FALSE()
			)
		formatString: #,##0
		displayFolder: 6 Previsão
		lineageTag: f41e713d-697b-cce9-532e-3019ebfc04bf

	/// O tamanho do erro do baseline: -44%. É o número do título da página,
	/// e existe como medida para que ele não seja um texto que envelhece.
	measure 'Erro da Previsão' =
			DIVIDE(
			    [Previsão — Média Móvel 3m] - [Realizado no Trimestre],
			    [Realizado no Trimestre]
			)
		formatString: 0.0%
		displayFolder: 6 Previsão
		lineageTag: a6851681-dca0-8567-91ed-cce47b1e119e

	column Coluna
		dataType: string
		isHidden
		lineageTag: e9dc395d-f55c-07df-6ab6-b22c46d359cf
		summarizeBy: none
		sourceColumn: Coluna

	partition _Medidas = m
		mode: import
		source =
				let
					Fonte = #table(type table [Coluna = text], {})
				in
					Fonte

