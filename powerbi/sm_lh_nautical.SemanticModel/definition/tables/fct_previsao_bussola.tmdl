/// Série mensal da Bússola de Bordo 702 (Questão 6), em formato longo:
/// realizado e três modelos na mesma coluna `unidades`, discriminados por
/// `serie`. Formato longo para que um único visual de linhas compare todos.
table fct_previsao_bussola
	lineageTag: 80dd2f04-43ae-2b44-794f-2e3fa6214c4b

	column ano_mes
		dataType: string
		lineageTag: 3e14f833-941e-5c28-52a3-9820bc78d602
		summarizeBy: none
		sourceColumn: ano_mes

	column data
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 347bd377-f73f-c8c9-0623-b51b19255a41
		summarizeBy: none
		sourceColumn: data

		annotation UnderlyingDateTimeDataType = Date

	column realizado
		dataType: double
		formatString: #,##0.00
		lineageTag: cc510ed0-f0d6-fa23-b17d-e78f83648385
		summarizeBy: sum
		sourceColumn: realizado

	column prev_mm3
		dataType: double
		formatString: #,##0.00
		lineageTag: fe32d276-a3ab-45e7-91a6-ced2d0944d18
		summarizeBy: sum
		sourceColumn: prev_mm3

	column prev_sazonal
