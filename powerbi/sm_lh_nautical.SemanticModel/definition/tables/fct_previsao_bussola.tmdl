		formatString: #,##0.00
		lineageTag: 958e9224-4d88-2cfa-3f4f-af5c8b94e48c
		summarizeBy: sum
		sourceColumn: prev_sazonal

	column prev_naive
		dataType: double
		formatString: #,##0.00
		lineageTag: f56c7608-3723-57cf-fbb0-8c260e976ff2
		summarizeBy: sum
		sourceColumn: prev_naive

	column eh_treino
		dataType: boolean
		lineageTag: 2f506fe4-8689-c715-589c-2aa50145cbf1
		summarizeBy: none
		sourceColumn: eh_treino

	partition fct_previsao_bussola = m
		mode: import
		source =
				let
					Arquivo = File.Contents(#"PastaDados" & "\fct_previsao_bussola.parquet"),
