{
  "name": "tema_lh_nautical",
  "dataColors": [
    "#2D9CDB",
    "#D9772A",
    "#8B7AE8",
    "#DE6161",
    "#AC7DD4"
  ],
  "background": "#0A121E",
  "backgroundLight": "#0E1826",
  "foreground": "#E8EEF4",
  "foregroundNeutralSecondary": "#93A5B8",
  "tableAccent": "#2D9CDB",
  "good": "#3FB98A",
  "neutral": "#6F8299",
  "bad": "#DE6161",
  "maximum": "#2D9CDB",
  "center": "#2A3F58",
  "minimum": "#16233A",
  "null": "#6F8299",
  "hyperlink": "#2D9CDB",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Light",
      "fontSize": 28,
      "color": "#E8EEF4"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#E8EEF4"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#B9C7D4"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#93A5B8"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0E1826"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E2E42"
              }
            },
            "radius": 10
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8EEF4"
              }
            },
            "fontSize": 11,
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#93A5B8"
              }
            },
            "fontSize": 9,
            "concatenateLabels": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#1A2738"
              }
            },
            "gridlineThickness": 1,
            "labelColor": {
              "solid": {
                "color": "#6F8299"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#93A5B8"
              }
            },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#B9C7D4"
              }
            },
            "fontSize": 9
          }
        ]
      }
    }
