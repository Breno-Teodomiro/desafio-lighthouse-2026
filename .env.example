# Conexão com o PostgreSQL 18 (instância do Windows, acessada via WSL mirrored)
# Copie para .env e preencha a senha. O .env está no .gitignore e nunca é versionado.
PGHOST=localhost
PGPORT=5432
PGDATABASE=lh_nautical
PGUSER=lh_app
PGPASSWORD=

# Instância compartilhada com outros projetos.
# Este projeto usa EXCLUSIVAMENTE o banco lh_nautical — ver as regras
